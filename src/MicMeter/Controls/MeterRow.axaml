<UserControl x:Class="MicMeter.Controls.MeterRow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MicMeter.Controls">
  <Panel>
    <Border x:Name="HorizontalBorder" BorderThickness="1" BorderBrush="Transparent"
            Background="#0AFFFFFF" CornerRadius="8" Padding="3">
      <Grid x:Name="HorizontalGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="68" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HorizontalMuteButton" Width="31" Height="31" Classes="overlay"
                  Click="MuteButton_Click">
            <Panel Width="18" Height="18">
              <Path Data="M15,4 C11.7,4 9,6.7 9,10 L9,23 C9,26.3 11.7,29 15,29 C18.3,29 21,26.3 21,23 L21,10 C21,6.7 18.3,4 15,4 Z M4,21 L4,23 C4,29.1 8.5,34.2 14,35 L14,40 L9,40 L9,43 L21,43 L21,40 L16,40 L16,35 C21.5,34.2 26,29.1 26,23 L26,21 L23,21 L23,23 C23,27.4 19.4,31 15,31 C10.6,31 7,27.4 7,23 L7,21 Z"
                    Fill="#FFEAF2FA" Stretch="Uniform" Margin="2,0" />
              <Line x:Name="HorizontalMuteSlash" StartPoint="2,2" EndPoint="16,16"
                    Stroke="#FFFF374B" StrokeThickness="2.5" IsVisible="False"
                    StrokeLineCap="Round" />
            </Panel>
          </Button>
          <Button x:Name="HorizontalListenButton" Width="31" Height="31" Classes="overlay"
                  Click="ListenButton_Click">
            <Path Data="M12,4 C7,4 3,8 3,13 L3,18 C3,19.7 4.3,21 6,21 L8,21 L8,12 L6,12 C6,8.7 8.7,6 12,6 C15.3,6 18,8.7 18,12 L16,12 L16,21 L18,21 C19.7,21 21,19.7 21,18 L21,13 C21,8 17,4 12,4 Z"
                  Fill="#FFEAF2FA" Stretch="Uniform" Width="16" Height="16" Margin="1,0" />
          </Button>
        </StackPanel>

        <Grid x:Name="HorizontalNameGrid" Grid.Column="1" Margin="2,1,10,1">
          <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="HorizontalDeviceNameText" Foreground="#FFB7C0C8" FontSize="9.5"
                     TextTrimming="CharacterEllipsis" />
          <controls:SegmentMeter x:Name="HorizontalMeter" Grid.Row="1" Margin="0,2,0,1"
                                 VerticalAlignment="Stretch" />
        </Grid>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="HorizontalLevelText" Text="-60.0 dB" Foreground="#FFF4F6F8"
                     FontFamily="Consolas" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" />
          <TextBlock x:Name="HorizontalStatusText" Text="LIVE" Foreground="#FF34D36B"
                     FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="VerticalBorder" IsVisible="False" BorderThickness="1" BorderBrush="Transparent"
            Background="#0AFFFFFF" CornerRadius="9" Padding="6">
      <Grid x:Name="VerticalGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
          <RowDefinition Height="22" />
          <RowDefinition Height="18" />
          <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="VerticalDeviceNameText" Foreground="#FFB7C0C8" FontSize="9.5"
                   TextTrimming="CharacterEllipsis" TextAlignment="Center" />
        <controls:SegmentMeter x:Name="VerticalMeter" Grid.Row="1" Width="27"
                               HorizontalAlignment="Center" Orientation="Vertical" />
        <TextBlock x:Name="VerticalLevelText" Grid.Row="2" Text="-60.0 dB" Foreground="#FFF4F6F8"
                   FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock x:Name="VerticalStatusText" Grid.Row="3" Text="LIVE" Foreground="#FF34D36B"
                   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="VerticalMuteButton" Width="34" Height="32" Classes="overlay"
                  Click="MuteButton_Click">
            <Panel Width="18" Height="18">
              <Path Data="M15,4 C11.7,4 9,6.7 9,10 L9,23 C9,26.3 11.7,29 15,29 C18.3,29 21,26.3 21,23 L21,10 C21,6.7 18.3,4 15,4 Z M4,21 L4,23 C4,29.1 8.5,34.2 14,35 L14,40 L9,40 L9,43 L21,43 L21,40 L16,40 L16,35 C21.5,34.2 26,29.1 26,23 L26,21 L23,21 L23,23 C23,27.4 19.4,31 15,31 C10.6,31 7,27.4 7,23 L7,21 Z"
                    Fill="#FFEAF2FA" Stretch="Uniform" Margin="2,0" />
              <Line x:Name="VerticalMuteSlash" StartPoint="2,2" EndPoint="16,16"
                    Stroke="#FFFF374B" StrokeThickness="2.5" IsVisible="False"
                    StrokeLineCap="Round" />
            </Panel>
          </Button>
          <Button x:Name="VerticalListenButton" Width="34" Height="32" Classes="overlay"
                  Click="ListenButton_Click">
            <Path Data="M12,4 C7,4 3,8 3,13 L3,18 C3,19.7 4.3,21 6,21 L8,21 L8,12 L6,12 C6,8.7 8.7,6 12,6 C15.3,6 18,8.7 18,12 L16,12 L16,21 L18,21 C19.7,21 21,19.7 21,18 L21,13 C21,8 17,4 12,4 Z"
                  Fill="#FFEAF2FA" Stretch="Uniform" Width="16" Height="16" Margin="1,0" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="CompactBorder" IsVisible="False" BorderThickness="1" BorderBrush="Transparent"
            Background="#0AFFFFFF" CornerRadius="6" Padding="2,1">
      <Grid x:Name="CompactGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="CompactMuteButton" Width="16" Height="16" VerticalAlignment="Center"
                Classes="overlay" Click="MuteButton_Click">
          <Ellipse x:Name="CompactMuteDot" Width="8" Height="8" Fill="#FF34D36B" />
        </Button>
        <Button x:Name="CompactListenButton" Grid.Column="1" Width="16" Height="16"
                VerticalAlignment="Center" Classes="overlay" Click="ListenButton_Click">
          <Ellipse x:Name="CompactListenDot" Width="8" Height="8" Fill="#FF55616B" />
        </Button>
        <controls:SegmentMeter x:Name="CompactMeter" Grid.Column="2" Height="10"
                               Margin="2,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Panel>
</UserControl>
