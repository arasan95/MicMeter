<Window x:Class="MicMeter.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicMeter 設定"
        Width="500" Height="790"
        MinWidth="450" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#FF0D131A"
        Foreground="#FFE7EEF6">
  <ScrollViewer>
    <StackPanel Margin="18" Spacing="10">
      <TextBlock Text="入力デバイス" FontSize="14" FontWeight="Bold" />
      <ListBox x:Name="DeviceListBox" MinHeight="120" MaxHeight="180">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <CheckBox Grid.Column="1" Content="表示" IsChecked="{Binding IsSelected}" />
              <CheckBox Grid.Column="2" Content="送信" IsChecked="{Binding IsLoopback}"
                        IsVisible="{Binding IsLoopbackVisible}" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="MoveUpButton" Content="↑ 上へ" Click="MoveUpButton_Click" />
        <Button x:Name="MoveDownButton" Content="↓ 下へ" Click="MoveDownButton_Click" />
      </StackPanel>
      <TextBlock Text="一覧の上から順に表示されます。項目を選び、上下ボタンで表示順を変更できます。"
                 FontSize="10" Foreground="#FF8DA0B0" TextWrapping="Wrap" />

      <TextBlock Text="大きさ" FontSize="14" FontWeight="Bold" />
      <Slider x:Name="ScaleSlider" Minimum="0.6" Maximum="2" />
      <TextBlock Text="透明度" FontSize="14" FontWeight="Bold" />
      <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" />

      <TextBlock Text="表示位置" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="PlacementComboBox" DisplayMemberBinding="{Binding Label}" />
      <TextBlock Text="セグメント数" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="SegmentCountComboBox" />
      <TextBlock x:Name="BufferSizeLabel" Text="バッファサイズ" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="BufferSizeComboBox">
        <ComboBoxItem Content="デフォルト（自動）" />
        <ComboBoxItem Content="128（低遅延・高負荷）" />
        <ComboBoxItem Content="256（低遅延）" />
        <ComboBoxItem Content="512" />
        <ComboBoxItem Content="1024（安定）" />
      </ComboBox>
      <TextBlock x:Name="RoutingModeLabel" Text="オーディオモード" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="RoutingModeComboBox">
        <ComboBoxItem Content="ループバック（仮想デバイス）" />
        <ComboBoxItem Content="プラグイン（LV2）" />
      </ComboBox>
      <TextBlock x:Name="ListeningOutputLabel" Text="リスニング出力" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="ListeningOutputComboBox" DisplayMemberBinding="{Binding Label}" />
      <TextBlock Text="メーター方向" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="OrientationComboBox">
        <ComboBoxItem Content="横型" />
        <ComboBoxItem Content="縦型" />
      </ComboBox>
      <TextBlock Text="テーマ" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="ThemeComboBox">
        <ComboBoxItem Content="Midnight Glass" />
        <ComboBoxItem Content="Flat Black（角丸なし）" />
      </ComboBox>
      <TextBlock Text="言語" FontSize="14" FontWeight="Bold" />
      <ComboBox x:Name="UiLanguageComboBox">
        <ComboBoxItem Content="日本語" />
        <ComboBoxItem Content="English" />
      </ComboBox>

      <CheckBox x:Name="TopmostCheckBox" Content="常に手前に表示" />
      <CheckBox x:Name="StartWithWindowsCheckBox" Content="起動時に自動起動" />
      <TextBlock Text="全ミュート・ホットキー" FontSize="14" FontWeight="Bold" />
      <Button x:Name="HotkeyButton" Content="Ctrl + Alt + M" Click="HotkeyButton_Click" HorizontalAlignment="Left" />

      <TextBlock Text="表示項目" FontSize="14" FontWeight="Bold" />
      <CheckBox x:Name="ShowDeviceNameCheckBox" Content="デバイス名" />
      <CheckBox x:Name="ShowLevelTextCheckBox" Content="dB数値" />
      <CheckBox x:Name="ShowStatusTextCheckBox" Content="状態文字" />
      <CheckBox x:Name="ShowMuteControlCheckBox" Content="ミュート操作" />
      <CheckBox x:Name="ShowListeningControlCheckBox" Content="リスニング操作" />
      <CheckBox x:Name="ShowPeakHoldCheckBox" Content="ピークホールド" />
      <CheckBox x:Name="ShowClippingWarningCheckBox" Content="CLIP警告" />
      <CheckBox x:Name="ShowTrayMeterCheckBox" Content="メニューバーメーター" />

      <CheckBox x:Name="PlayMuteSoundsCheckBox" Content="ミュート通知音" />
      <CheckBox x:Name="ShowMuteOverlayCheckBox" Content="ミュート表示" />
      <Button x:Name="MuteOverlayPlacementButton" Content="ミュート表示の位置を調整"
              Click="MuteOverlayPlacementButton_Click" HorizontalAlignment="Left" />

      <TextBlock Text="メーターバーの色と切替位置" FontSize="14" FontWeight="Bold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="LowColorButton" Tag="Low" Click="ColorButton_Click" />
        <Button x:Name="MidColorButton" Tag="Mid" Click="ColorButton_Click" />
        <Button x:Name="HighColorButton" Tag="High" Click="ColorButton_Click" />
      </StackPanel>
      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="中色へ切替 (dB)" FontSize="12" />
          <TextBox x:Name="MidThresholdTextBox" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="高色へ切替 (dB)" FontSize="12" />
          <TextBox x:Name="HighThresholdTextBox" />
        </StackPanel>
      </Grid>
      <TextBlock Text="細くリサイズすると文字は自動で隠れ、ミュートとリスニングは点表示になります。耳ボタンはヘッドホン使用を推奨します。"
                 FontSize="10" Foreground="#FF8DA0B0" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="QuitButton" Content="終了" Click="QuitButton_Click" />
        <Button x:Name="CloseButton" Content="閉じる" Click="CloseButton_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
